# Admin area — protected by PHP session check (see admin/index.php).
# Block obvious sensitive files only; do not deny the directory itself.

<FilesMatch "\.(sql|env|env\.example|log|bak|ini|md|json|yml|yaml|sh|htpasswd|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>
