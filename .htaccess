Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Surrogate-Control "no-store"
    Header always unset X-Powered-By
</IfModule>

<FilesMatch "\.(env|env\.example|sql|sql\.gz|bak|log|md|json|lock|ini|yml|yaml|sh|gitignore|gitattributes|htpasswd)$">
    Require all denied
</FilesMatch>

<Files "manifest.json">
    Require all granted
</Files>

<Files "sw.js">
    Require all granted
</Files>

RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 /\.(git|svn|idea|vscode)

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/?(app|config|uploads|partials|data|admin|api|books|assets)/
    RewriteRule ^/?books/([a-z0-9-]+)/?$  books/product.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_URI} !^/?(app|config|uploads|partials|data|admin|api|courses|assets)/
    RewriteRule ^/?courses/([a-z0-9-]+)/?$ courses/course.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_URI} !^/?(app|config|uploads|partials|data|admin|api|blog|assets)/
    RewriteRule ^/?blog/([a-z0-9-]+)/?$  blog/post.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_URI} !^/?(app|config|uploads|partials|data|admin|api|country|assets)/
    RewriteRule ^/?country/([a-z0-9-]+)/?$ country/country.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
